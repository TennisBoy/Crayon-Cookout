# Crayon Cookout — environment template
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real values.
# Every variable here is optional to BOOT: with none of them set the stack
# still starts and /api/health answers. Capabilities that need a key return
# 503 with a clear message rather than failing at startup.

# --- Runtime ----------------------------------------------------------------
ENVIRONMENT=production          # production | development
LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR

# --- Ports (host side, bound to 127.0.0.1 only) -----------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- Database ---------------------------------------------------------------
# Designs and collectibles are plain SQL over this connection. Supabase
# dashboard → Connect → use the SESSION POOLER string, not the direct :5432
# host: that one is IPv6-only on newer projects and will not resolve from an
# IPv4 VM. Contains the database password, so treat it as a secret.
#
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Max pooled connections. The whole app is one process; Supabase's free tier
# has a modest connection ceiling, so keep this small.
DATABASE_POOL_MAX=5

# --- Supabase (auth only) ----------------------------------------------------
# Register, OTP, login, password reset and refresh are GoTrue calls — there is
# no SQL equivalent, so this is required even though the tables are reached
# over DATABASE_URL. Settings → API. See docs/supabase-setup.md.
SUPABASE_URL=https://your-project-ref.supabase.co

# SERVICE ROLE KEY — bypasses row-level security. Backend only.
# If this ever appears in frontend code or a VITE_ variable, rotate it
# immediately: anyone with it can read and write every user's data.
SUPABASE_SERVICE_ROLE_KEY=

# Anon key. Safe to expose in principle; currently unused because the browser
# talks only to our API, never to Supabase directly.
SUPABASE_ANON_KEY=

# --- Vision (collectible photo verification) --------------------------------
# Optional. Without it, /api/vision/verify-crayon returns 503 and the
# collectibles scanner reports "didn't match" rather than silently passing.
ANTHROPIC_API_KEY=
VISION_MODEL=claude-sonnet-4-5

# --- CORS -------------------------------------------------------------------
# Exact origins, comma-separated. "*" is rejected at startup.
# With Cloudflare routing /api on the same hostname as the SPA, cross-origin
# requests never happen and this only matters for local development.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---------------------------------------------------------------
# Baked in at BUILD time by Vite, not read at runtime. Changing it requires
# `docker compose build frontend`, not just a restart.
# "/api" = same-origin, which is what the Cloudflare Tunnel setup expects.
VITE_API_BASE_URL=/api
